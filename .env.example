# =========================
# APP
# =========================
APP_PORT=8084
APP_ENV=development
APP_NAME=payment-service
WEB_PREFORK=false
LOG_LEVEL=debug

JWT_SECRET_KEY=super-secret-key

GATEWAY_SECRET_KEY=veggo-gateway-secret-key
REQUEST_API_GATEWAY=true

SERVER_TIMEOUT=30

PRODUCT_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8090
ORDER_SERVICE_URL=http://localhost:8083

# =========================
# DATABASE
# =========================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=root_password
DATABASE_NAME=veggo_payment_service
DATABASE_MAX_OPEN_CONNECTION=25
DATABASE_MAX_IDLE_CONNECTION=10

# =========================
# KAFKA
# =========================
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=order-service-group
KAFKA_PRODUCER_ENABLED=true

# =========================
# TOPIC
# =========================
TOPIC_PAYMENT_SUCCESS=payment-success

# =========================
# MINIO
# =========================
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=veggo-payment-service
MINIO_USE_SSL=false

# =========================
# REDIS
# =========================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=password

# =========================
# MIDTRANS
# =========================
MIDTRANS_SERVER_KEY=xxx
MIDTRANS_ENVIRONMENT=sandbox
